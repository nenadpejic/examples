{
	"name": "github-actions-example",
	"version": "0.0.1",
	"description": "Comprehensive GitHub Actions CI/CD examples with React, TypeScript, and Vite",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"test": "vitest",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest --coverage",
		"lint": "eslint src tests --ext .ts,.tsx",
		"lint:fix": "eslint src tests --ext .ts,.tsx --fix",
		"format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\"",
		"format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\""
	},
	"dependencies": {
		"react": "^18.3.1",
		"react-dom": "^18.3.1"
	},
	"devDependencies": {
		"@testing-library/react": "^14.3.1",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^20.19.39",
		"@types/react": "^18.3.28",
		"@types/react-dom": "^18.3.7",
		"@typescript-eslint/eslint-plugin": "^8.59.2",
		"@typescript-eslint/parser": "^8.59.2",
		"@vitejs/plugin-react": "^4.7.0",
		"@vitest/coverage-v8": "^4.1.5",
		"@vitest/ui": "^4.1.5",
		"eslint": "^8.57.1",
		"eslint-config-prettier": "^9.1.2",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^4.6.2",
		"jsdom": "^23.2.0",
		"prettier": "^3.8.3",
		"typescript": "^5.9.3",
		"vite": "^8.0.10",
		"vitest": "^4.1.5"
	}
}
